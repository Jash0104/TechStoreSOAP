<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Endpoint del servicio SOAP que consume esta aplicación -->
    <add key="UrlServicio" value="http://localhost:51080/ProductoService.asmx" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <globalization culture="es-CO" uiCulture="es-CO" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>
</configuration>
